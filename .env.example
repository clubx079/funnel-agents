# Copy to .env.local (not in git) and fill in. Never commit real values.

# ---- Site ----
# Public URL of this site, no trailing slash (canonical links, sitemap).
NEXT_PUBLIC_SITE_URL=
# "true" lets search engines index the site; anything else adds noindex.
SITE_INDEXABLE=
# Google Tag Manager container id (GTM-XXXXXXX). Empty = no GTM.
NEXT_PUBLIC_GTM_ID=
# Build output folder; set (e.g. .next-build) to build next to a running dev server. Default .next.
NEXT_DIST=

# ---- PostHog (same project as the Casa-Libre sites) ----
# Project's public client key. Empty = the Casa-Libre project's public key built into lib/analytics.js.
NEXT_PUBLIC_POSTHOG_KEY=
# Ingest host. Empty = https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# ---- Leads: Casa-Libre database per country (server only, read at request time, never NEXT_PUBLIC) ----
# Each lead goes to public.funnel_leads in the DB of the country whose form was filled in.
# Missing or failing DB = the lead is saved to data/leads.jsonl on the server instead.
# Paraguay AiroBase URL (https://<id>.db.airosofts.com)
AIROBASE_URL_PY=
# Paraguay AiroBase secret key
AIROBASE_SECRET_KEY_PY=
# Bolivia AiroBase URL
AIROBASE_URL_BO=
# Bolivia AiroBase secret key
AIROBASE_SECRET_KEY_BO=
# Uruguay AiroBase URL
AIROBASE_URL_UY=
# Uruguay AiroBase secret key
AIROBASE_SECRET_KEY_UY=
# Venezuela AiroBase URL
AIROBASE_URL_VE=
# Venezuela AiroBase secret key
AIROBASE_SECRET_KEY_VE=
# El Salvador AiroBase URL
AIROBASE_URL_SV=
# El Salvador AiroBase secret key
AIROBASE_SECRET_KEY_SV=

# ---- Optional webhook (each lead is also POSTed here) ----
# URL that receives a copy of every lead. Empty = off.
LEADS_WEBHOOK_URL=
# Sent as the x-lead-secret header to the webhook.
LEADS_WEBHOOK_SECRET=
